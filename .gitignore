# ===============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===============================
# IDE / EDITOR FILES
# ===============================
.vscode/
.idea/
*.swp
*.swo
*.swn

# ===============================
# TEMP / CACHE FILES
# ===============================
tmp/
temp/
.cache/
.npm/
.eslintcache

# ===============================
# BUILD / DIST (future safety)
# ===============================
dist/
build/

# ===============================
# COVERAGE / TEST
# ===============================
coverage/

# ===============================
# OPTIONAL: LOCAL DATABASE FILES
# ===============================
*.sqlite
*.sqlite3
